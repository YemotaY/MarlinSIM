; Sample G-code for MarlinSIM testing
; Generated by test fixture — simple 3-layer cube
;
; Printer: Ender 3 V2
; Layer height: 0.2mm
; Nozzle: 0.4mm
;
G28 ; Home all axes
G92 E0 ; Reset extruder
M104 S200 ; Set hotend temp
M140 S60  ; Set bed temp
M190 S60  ; Wait for bed
M109 S200 ; Wait for hotend
G1 Z5 F3000 ; Lift nozzle

;LAYER:0
;Z:0.2
G1 Z0.2 F1000
G1 X10 Y10 F3000 ; Move to start
G1 X50 Y10 E2.0 F1500
G1 X50 Y50 E4.0 F1500
G1 X10 Y50 E6.0 F1500
G1 X10 Y10 E8.0 F1500

;LAYER:1
;Z:0.4
G1 Z0.4 F1000
G1 X10 Y10 F3000
G1 X50 Y10 E10.0 F1500
G1 X50 Y50 E12.0 F1500
G1 X10 Y50 E14.0 F1500
G1 X10 Y10 E16.0 F1500

;LAYER:2
;Z:0.6
G1 Z0.6 F1000
G1 X10 Y10 F3000
G1 X50 Y10 E18.0 F1500
G1 X50 Y50 E20.0 F1500
G1 X10 Y50 E22.0 F1500
G1 X10 Y10 E24.0 F1500

;LAYER:3
;Z:0.8
G1 Z0.8 F1000
G1 X10 Y10 F3000
G1 X50 Y10 E26.0 F1500
G1 X50 Y50 E28.0 F1500
G1 X10 Y50 E30.0 F1500
G1 X10 Y10 E32.0 F1500

;LAYER:4
;Z:1.0
G1 Z1.0 F1000
G1 X10 Y10 F3000
G1 X50 Y10 E34.0 F1500
G1 X50 Y50 E36.0 F1500
G1 X10 Y50 E38.0 F1500
G1 X10 Y10 E40.0 F1500

G1 Z5 F3000 ; Lift
M104 S0     ; Hotend off
M140 S0     ; Bed off
M84         ; Motors off
